+    // ===== PREVIEW-LIFT GUARD: per-user write throttle =====
+    // rateLimits/{uid}: { lastPostAt, lastMsgAt, day, dayCount }
+    // Gap: 20s between posts/replies, 2s between DMs. Daily cap: 50 posts+replies (UTC day).
+    match /rateLimits/{uid} {
+      function rlKeysOk(d) {
+        return d.keys().hasOnly(['lastPostAt', 'lastMsgAt', 'day', 'dayCount']);
+      }
+      function postBump(before, after) {
+        return after.lastPostAt == request.time
+          && (!before.keys().hasAny(['lastPostAt'])
+              || request.time > before.lastPostAt + duration.value(20, 's'))
+          && after.day == request.time.date()
+          && ((before.keys().hasAny(['day']) && before.day == request.time.date())
+                ? (after.dayCount == before.dayCount + 1 && after.dayCount <= 50)
+                : after.dayCount == 1);
+      }
+      function msgBump(before, after) {
+        return after.lastMsgAt == request.time
+          && (!before.keys().hasAny(['lastMsgAt'])
+              || request.time > before.lastMsgAt + duration.value(2, 's'));
+      }
+      function changed(before, after) {
+        return after.diff(before).affectedKeys();
+      }
+      allow read: if signedIn() && request.auth.uid == uid;
+      allow create: if signedIn() && request.auth.uid == uid
+        && rlKeysOk(request.resource.data)
+        && request.resource.data.keys().hasAny(['lastPostAt', 'lastMsgAt'])
+        && (!request.resource.data.keys().hasAny(['lastPostAt']) || postBump({}, request.resource.data))
+        && (!request.resource.data.keys().hasAny(['lastMsgAt']) || msgBump({}, request.resource.data));
+      allow update: if signedIn() && request.auth.uid == uid
+        && rlKeysOk(request.resource.data)
+        && (
+          (changed(resource.data, request.resource.data).hasOnly(['lastPostAt', 'day', 'dayCount'])
+            && postBump(resource.data, request.resource.data))
+          || (changed(resource.data, request.resource.data).hasOnly(['lastMsgAt'])
+            && msgBump(resource.data, request.resource.data))
+        );
+      allow delete: if isAdmin();
     }
