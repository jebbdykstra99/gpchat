rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // siteIds = each room's site.json "siteId" (the factory.js upload path is posts/<siteId>/<uid>/...).
    // 2026-10-09 draft: + 311chat and the four wave-four rooms (airlineschat, amachat, atmchat,
    // behindtheblackwall), which were missing, so image/story uploads there were denied.
    // Same size/type limits as every other room (posts: image/*, < 5 MB; stories: image/* or mp4/webm, < 8 MB).
    function factorySiteId(siteId) {
      return siteId in [
        'samochat', 'bartchat', '415chat', 'gpchat', '27chat', '808chat',
        'buffettchat', 'gaichat', 'popechat', 'recruitchat',
        'booze', 'buffet', 'boyfriend', 'cia', 'cobra',
        '311chat', 'airlineschat', 'amachat', 'atmchat', 'behindtheblackwall'
      ];
    }
    // 2026-10-12 (Jebb-approved): rooms with uploads OFF. gpchat: no member photo/story uploads
    // (site.json imageUploads false, stories off). Read and own-file delete still work.
    function uploadSiteId(siteId) {
      return factorySiteId(siteId) && !(siteId in ['gpchat']);
    }

    match /posts/{siteId}/{uid}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.uid == uid
        && uploadSiteId(siteId)
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 5 * 1024 * 1024;
      allow delete: if request.auth != null
        && request.auth.uid == uid
        && factorySiteId(siteId);
    }

    match /stories/{siteId}/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && uploadSiteId(siteId)
        && request.resource.size < 8 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'video/mp4'
          || request.resource.contentType == 'video/webm'
        );
      allow delete: if request.auth != null
        && request.auth.uid == userId
        && factorySiteId(siteId);
    }
  }
}
